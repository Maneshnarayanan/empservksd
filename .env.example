# Environment Configuration for employeeserviceksd.com

# Server Environment & Port
NODE_ENV=development
PORT=3000

# Application Base URL
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Either provide a connection string:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/employeeserviceksd
# Or individual connection parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=employeeserviceksd
DB_SSL=false

# Session Configuration
SESSION_SECRET=change_this_to_a_cryptographically_secure_random_64_char_string
SESSION_NAME=esksd_sid
SESSION_MAX_AGE_MS=86400000

# CSRF Protection Secret
CSRF_SECRET=change_this_to_a_strong_random_secret_for_csrf_signing

# File Storage Configuration (Absolute or relative path)
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=15728640

# Initial Admin Setup (Used only when running scripts/create-admin.js if not provided interactively)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@employeeserviceksd.com
ADMIN_DEFAULT_PASSWORD=ChangeMeImmediately123!
ADMIN_DEFAULT_FULLNAME=Site Administrator
